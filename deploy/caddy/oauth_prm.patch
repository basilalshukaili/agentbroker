+	@oauth_prm path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
+	handle @oauth_prm {
+		reverse_proxy 127.0.0.1:8010 {
+			header_up X-Forwarded-Proto https
+			header_up -X-Real-IP
+		}
+	}
