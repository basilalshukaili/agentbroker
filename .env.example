# Copy to .env and fill in. Never commit .env.

# --- Service ---
ENVIRONMENT=development
SERVICE_VERSION=0.1.0
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
REQUIRE_AUTH=false

# --- Twilio (transactional only outside US until 10DLC is set up) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- Cal.com ---
CALCOM_API_KEY=
CALCOM_USERNAME=

# --- Vapi ---
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_PHONE_NUMBER_ID=

# --- Resend (replaces SendGrid; 3000/mo free, sign up at https://resend.com) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Billing provider — pick one that works in your country ---
# polar | lemonsqueezy | coinbase | manual
BILLING_PROVIDER=manual
POLAR_API_KEY=
POLAR_ORG_ID=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
COINBASE_COMMERCE_API_KEY=
WISE_PAYMENT_LINK=

# --- Auth ---
AGENT_IDENTITY_SIGNING_SECRET=
BILLING_RECEIPT_SIGNING_SECRET=

# --- Storage ---
DATABASE_URL=postgresql://smb_broker:smb_broker@localhost:5432/smb_broker
REDIS_URL=redis://localhost:6379/0

# --- Compliance defaults ---
COMPLIANCE_DEFAULT_JURISDICTION=international
COMPLIANCE_STRICT_MODE=true
